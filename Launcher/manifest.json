  "sources": [
    {
      "id": "amdnr",
      "name": "AMDNR",
      "author": "3zwr1",
      "summary": "AMDNR: our build of OptiScaler with AMD Neural Rendering. Its own lmxxf runtime built in for RX 7000 and RX 9000, the optional DLSSNR AMD files by danielblnc, FSR frame generation, our own engine fixes, the in-game menu, crash reports, and this launcher's Doctor and support.",
      "homepage": "https://github.com/3zwr1/AMD-NR---OptiScaler",
      "package": "amdnr",
      "forwarder": "forwarder",
      "runtimeRequired": false,
      "runtimeNote": "Recommended on every GPU. On RX 7000 and RX 9000, AMDNR can also use its built-in lmxxf runtime.",
      "runtimes": [
        {
          "package": "runtime-051",
          "gpus": ["rdna4", "rdna3"]
        },
        {
          "package": "runtime-050",
          "gpus": ["rdna4", "rdna3"]
        },
        {
          "package": "runtime-043",
          "gpus": ["rdna4", "rdna3"]
        },
        {
          "package": "runtime-041",
          "gpus": ["rdna4", "rdna3"]
        },
        {
          "package": "runtime-040",
          "gpus": ["rdna4", "rdna3"]
        }
      ]
    },
    {
      "id": "theautomatic",
      "name": "OptiScaler AMD pre-SR",
      "author": "TheAutomatic",
      "summary": "OptiScaler AMD pre-SR: TheAutomatic's independent fork of the same family, offered for comparison. Downloaded unchanged from their GitHub releases; same danielblnc files, his own lmxxf backend and menu, his own fixes.",
      "homepage": "https://github.com/TheAutomatic/dlss-5-amd-project",
      "package": "theautomatic",
      "forwarder": null,
      "runtimeRequired": true,
      "runtimeNote": "Required: this build does not include danielblnc's runtime, and its lmxxf backend needs model files that are not in its release.",
      "iniWhenRuntime": [
        {
          "section": "DlssNr",
          "key": "Enabled",
          "value": "true"
        },
        {
          "section": "DlssNr",
          "key": "NrBackend",
          "value": "daniel"
        }
      ],
      "runtimes": [
        {
          "package": "runtime-051",
          "gpus": ["rdna4", "rdna3"]
        },
