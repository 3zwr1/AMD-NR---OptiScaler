From bf42b6a52a44cbf56dc1a2a010be5e90040e7c30 Mon Sep 17 00:00:00 2001
From: AMDNR <noreply@anthropic.com>
Date: Sat, 3 Oct 2026 12:11:30 +0100
Subject: [PATCH 1/3] fix(overlay): an unreadable UI font no longer kills
 scaling

On a player's PC reading C:\Windows\Fonts\SegUIVar.ttf failed inside the
host, so OverlayDrawer::_BuildFonts returned false, Renderer::Initialize
failed, and the scaling window reported Diagnostic MP-033 and never scaled
(Need for Speed Heat, and any screen-sized / fullscreen game). Capture, FSR 3
and the optical flow had all initialised fine - only the overlay font failed.

Fall back to ImGui's built-in font for the three font slots when the UI font
cannot be read: the overlay draws in a basic face and the upscale and NR keep
running. The fallback is never written to the font cache, so the next start
tries the real font again.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/Magpie.Core/OverlayDrawer.cpp | 35 ++++++++++++++++++++++++++++---
 1 file changed, 32 insertions(+), 3 deletions(-)

diff --git a/src/Magpie.Core/OverlayDrawer.cpp b/src/Magpie.Core/OverlayDrawer.cpp
index 686a0fe..c2ee5f4 100644
--- a/src/Magpie.Core/OverlayDrawer.cpp
+++ b/src/Magpie.Core/OverlayDrawer.cpp
@@ -428,6 +428,13 @@ bool OverlayDrawer::_BuildFonts() noexcept {
 	const std::wstring& language = GetAppLanguage();
 	ImFontAtlas& fontAtlas = *ImGui::GetIO().Fonts;
 
+	// (AMDNR) A UI font that cannot be read must not take scaling down with it. On a player's PC the SegUIVar.ttf
+	// read failed, _BuildFonts returned false, Renderer::Initialize failed, and the window reported Diagnostic
+	// MP-033 and never scaled at all (NFS Heat, and any screen-sized game). The overlay is not worth losing the
+	// upscale and NR over: fall back to ImGui's built-in font, and never cache that fallback so the next start
+	// tries the real font again.
+	bool usedFallbackFont = false;
+
 	auto buildFontAtlas = [&]() {
 		fontAtlas.Flags |= ImFontAtlasFlags_NoPowerOfTwoHeight | ImFontAtlasFlags_NoMouseCursors;
 
@@ -443,8 +450,27 @@ bool OverlayDrawer::_BuildFonts() noexcept {
 
 		std::vector<uint8_t> uiFontData;
 		if (!Win32Helper::ReadFile(uiFontPath.c_str(), uiFontData)) {
-			Logger::Get().Error("读取字体文件失败");
-			return false;
+			Logger::Get().Error("读取字体文件失败; using the built-in font so scaling continues (overlay only)");
+
+			ImFontConfig fallbackConfig;
+			fallbackConfig.SizePixels = _dpiScale > 1.0f ? 13.0f * _dpiScale : 13.0f;
+			ImFont* fallbackFont = fontAtlas.AddFontDefault(&fallbackConfig);
+			if (!fallbackFont) {
+				Logger::Get().Error("内置字体也失败");
+				return false;
+			}
+
+			_fontUI = fallbackFont;
+			_fontMonoNumbers = fallbackFont;
+			_fontIcons = fallbackFont;
+
+			if (!fontAtlas.Build()) {
+				Logger::Get().Error("构建 ImFontAtlas 失败");
+				return false;
+			}
+
+			usedFallbackFont = true;
+			return true;
 		}
 
 		// 构建 ImFontAtlas 前 ranges 不能析构，因为 ImGui 只保存了指针
@@ -474,7 +500,10 @@ bool OverlayDrawer::_BuildFonts() noexcept {
 				return false;
 			}
 
-			ImGuiFontsCacheManager::Get().Save(language, dpi, fontAtlas);
+			// (AMDNR) never cache the built-in fallback: the next start must try the real font again
+			if (!usedFallbackFont) {
+				ImGuiFontsCacheManager::Get().Save(language, dpi, fontAtlas);
+			}
 		}
 	}
 
