          ]
        },
        {
          "package": "runtime-040",
          "gpus": [
            "rdna4",
            "rdna3"
          ]
        }
      ],
      "helixSr": {
        "amdPackage": "helix-amd-sdk",
        "downloadDlss": true,
        "package": "helixsr-release"
      },
      "modelLSr": {
        "package": "model-l-release"
      },
      "components": {
        "neuralHub080": "amdnr-neuralhub080-host",
        "mochizuki": "amdnr-modelb-mochizuki",
        "lmxxf": "amdnr-lmxxf"
      }
    },
    {
      "id": "theautomatic",
      "name": "OptiScaler AMD pre-SR",
      "author": "TheAutomatic",
      "summary": "OptiScaler AMD pre-SR: TheAutomatic's independent fork of the same family, offered for comparison. Downloaded unchanged from their GitHub releases; same danielblnc files, his own lmxxf backend and menu, his own fixes.",
      "homepage": "https://github.com/TheAutomatic/dlss-5-amd-project",
      "package": "theautomatic",
      "forwarder": "forwarder",
      "runtimeRequired": false,
      "runtimeNote": "Required: this build does not include danielblnc's runtime, and its lmxxf backend needs model files that are not in its release.",
      "iniWhenRuntime": [
        {
          "section": "DlssNr",
          "key": "Enabled",
          "value": "true"
        },
        {
          "section": "DlssNr",
          "key": "NrBackend",
          "value": "daniel"
        }
