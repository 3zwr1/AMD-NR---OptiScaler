diff --git a/scripts/tests/test_auto_scale_rearm.py b/scripts/tests/test_auto_scale_rearm.py
new file mode 100644
index 0000000..4cc0bbb
--- /dev/null
+++ b/scripts/tests/test_auto_scale_rearm.py
@@ -0,0 +1,316 @@
+"""Exercise the extracted production auto-scale latch without windows or a GPU.
+
+A stop the player asked for must keep blocking the automatic check, exactly as
+before. A stop nobody asked for must leave the check armed, but only for a
+bounded number of restarts in a row.
+"""
+from pathlib import Path
+import sys
+
+root = Path(__file__).resolve().parents[2]
+
+
+def method(text, signature):
+    start = text.index(signature)
+    end = text.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+def read(path):
+    return (root / path).read_text(encoding='utf-8-sig')
+
+
+service = read('src/Magpie/ScalingService.cpp')
+runtime = read('src/Magpie.Core/ScalingRuntime.cpp')
+
+rearm = method(service, 'bool ScalingService::_ShouldRearmAutoScale(')
+state_changed = method(service, 'void ScalingService::_ScalingRuntime_StateChanged(')
+foreground_tick = method(service, 'void ScalingService::_CheckForegroundTimer_Tick(')
+publish_state = method(runtime, 'void ScalingRuntime::_State(')
+
+# The stop handler still latches on the source window, and now also clears the
+# latch, which is what the involuntary case needs.
+assert '_hwndChecked = _hwndCurSrc;' in state_changed
+assert '_hwndChecked = NULL;' in state_changed
+assert 'stoppedByUser' in state_changed and '_ShouldRearmAutoScale' in state_changed
+# The automatic check still returns early for an already checked window, and it
+# still records every foreground window it has seen - including the source while
+# a run is healthy, which is why clearing is necessary.
+assert 'hwndFore == _hwndChecked' in foreground_tick
+assert '_hwndChecked = hwndFore;' in foreground_tick
+# The cause is published before the notification, never after.
+assert publish_state.index('_stoppedByUser.store') < publish_state.index('StateChanged.Invoke')
+
+harness = r'''
+#include <windows.h>
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdint>
+#include <iostream>
+#include <string>
+
+static HWND const GAME = (HWND)0x400e4a;
+static HWND const OVERLAY = (HWND)0x9001;
+
+static HWND g_foreground = NULL;
+static HWND FakeForeground() { return g_foreground; }
+#define GetForegroundWindow FakeForeground
+
+namespace winrt {
+struct DispatcherQueueTimer {};
+struct IInspectable {};
+}
+
+namespace fmt {
+template <typename... T>
+static std::string format(const char*, T&&...) { return {}; }
+}
+
+struct Logger {
+    static Logger& Get() { static Logger l; return l; }
+    void Info(const std::string&) {}
+    void Flush() {}
+};
+
+enum class ScalingState { Idle, Starting, Scaling, Stopping, Waiting };
+enum class StopCause { Involuntary, UserRequested };
+enum class AutoScale { Disabled, Fullscreen, Windowed };
+
+struct Profile {
+    AutoScale autoScale = AutoScale::Fullscreen;
+};
+
+static Profile g_profile;
+static bool g_hasProfile = true;
+struct ProfileService {
+    static ProfileService& Get() { static ProfileService s; return s; }
+    // Only the game has a profile that asks for automatic scaling.
+    const Profile* GetProfileForWindow(HWND hWnd, bool) {
+        return (g_hasProfile && hWnd == GAME) ? &g_profile : nullptr;
+    }
+};
+
+struct AppSettings {
+    static AppSettings& Get() { static AppSettings s; return s; }
+    bool IsSmoothMotionCompatibilityMode() const { return false; }
+    void Save() {}
+};
+
+struct FakeDispatcher {
+    template <typename F>
+    bool TryEnqueue(F&& f) const { f(); return true; }
+};
+struct App {
+    static App& Get() { static App a; return a; }
+    const FakeDispatcher& Dispatcher() const { static FakeDispatcher d; return d; }
+    void RestartForSmoothMotion() {}
+};
+
+// Only the pieces of the runtime the latch reads.
+struct ScalingRuntime {
+    std::atomic<ScalingState> _state = ScalingState::Scaling;
+    std::atomic<bool> _stoppedByUser = false;
+    struct { void Invoke(ScalingState) {} } StateChanged;
+    ScalingState State() const noexcept { return _state.load(std::memory_order_relaxed); }
+    bool WasStoppedByUser() const noexcept { return _stoppedByUser.load(std::memory_order_relaxed); }
+    void _State(ScalingState value, StopCause cause = StopCause::Involuntary);
+};
+
+__PUBLISH_STATE__
+
+struct Event { void Invoke(bool) {} };
+
+struct ScalingService {
+    static ScalingService& Get() { static ScalingService s; return s; }
+
+    ScalingRuntime runtime;
+    ScalingRuntime* _scalingRuntime = &runtime;
+
+    HWND _hwndCurSrc = NULL;
+    bool _isAutoScaleSuspended = false;
+    HWND _hwndChecked = NULL;
+    HWND _hwndLastInvoluntaryStop = NULL;
+    uint32_t _involuntaryStops = 0;
+    std::chrono::steady_clock::time_point _lastInvoluntaryStop{};
+    uint32_t _windowsWithoutProfileLogged = 0;
+
+    Event IsScalingChanged;
+    int starts = 0;
+    HWND lastStarted = NULL;
+
+    void StopTimer() {}
+    void _FlushEffectParametersSaves(bool = false) {}
+    void _LogWindowWithoutProfile(HWND) noexcept {}
+    void _StartScale(HWND hWnd, const Profile&, bool, bool) { ++starts; lastStarted = hWnd; }
+
+    bool _ShouldRearmAutoScale(HWND hwndSrc,
+        std::chrono::steady_clock::time_point now = std::chrono::steady_clock::now()) noexcept;
+    void _ScalingRuntime_StateChanged(ScalingState value);
+    void _CheckForegroundTimer_Tick(winrt::DispatcherQueueTimer const&, winrt::IInspectable const&);
+};
+
+static bool IsPopupWindow(HWND, HWND) noexcept { return false; }
+static bool IsReadyForScaling(HWND) noexcept { return true; }
+
+__REARM__
+__STATE_CHANGED__
+__FOREGROUND_TICK__
+
+static void Reset() {
+    auto& s = ScalingService::Get();
+    s._hwndCurSrc = GAME;
+    s._hwndChecked = NULL;
+    s._hwndLastInvoluntaryStop = NULL;
+    s._involuntaryStops = 0;
+    s._lastInvoluntaryStop = {};
+    s._isAutoScaleSuspended = false;
+    s.starts = 0;
+    s.lastStarted = NULL;
+    s.runtime._state = ScalingState::Scaling;
+    s.runtime._stoppedByUser = false;
+    g_foreground = GAME;
+    g_hasProfile = true;
+}
+
+// One involuntary stop, with the source window in front, as the reports describe.
+static void StopInvoluntarily() {
+    auto& s = ScalingService::Get();
+    s._hwndCurSrc = GAME;
+    s.runtime._State(ScalingState::Idle, StopCause::Involuntary);
+    s._ScalingRuntime_StateChanged(ScalingState::Idle);
+}
+
+static void StopOnPurpose() {
+    auto& s = ScalingService::Get();
+    s._hwndCurSrc = GAME;
+    s.runtime._State(ScalingState::Idle, StopCause::UserRequested);
+    s._ScalingRuntime_StateChanged(ScalingState::Idle);
+}
+
+// A healthy run: scaling is active on the game and the foreground check records
+// the source as already checked on every tick. That is the state every stop
+// starts from, and the reason an involuntary stop has to clear the mark rather
+// than just leave it alone.
+static void RunHealthyTicks() {
+    auto& s = ScalingService::Get();
+    s._hwndCurSrc = GAME;
+    s.starts = 0;
+    g_foreground = GAME;
+    s._CheckForegroundTimer_Tick({}, {});
+    s._CheckForegroundTimer_Tick({}, {});
+    assert(s._hwndChecked == GAME && s.starts == 0);
+}
+
+int main() {
+    using namespace std::chrono;
+    auto& s = ScalingService::Get();
+
+    // A stop the player asked for keeps today's behaviour: the source stays
+    // marked as checked and the automatic check does nothing while it is in front.
+    Reset();
+    RunHealthyTicks();
+    StopOnPurpose();
+    assert(s._hwndChecked == GAME);
+    s._CheckForegroundTimer_Tick({}, {});
+    assert(s.starts == 0);
+    // Only another window taking the foreground releases it, as before.
+    g_foreground = OVERLAY;
+    s._CheckForegroundTimer_Tick({}, {});
+    g_foreground = GAME;
+    s._CheckForegroundTimer_Tick({}, {});
+    assert(s.starts == 1 && s.lastStarted == GAME);
+
+    // A stop nobody asked for releases the source, so scaling comes back by
+    // itself while the player sits in the same game. Leaving the mark alone
+    // would not be enough - the healthy run already set it.
+    Reset();
+    RunHealthyTicks();
+    StopInvoluntarily();
+    assert(s._hwndChecked == NULL);
+    s._CheckForegroundTimer_Tick({}, {});
+    assert(s.starts == 1 && s.lastStarted == GAME);
+
+    // Bounded: three restarts in a row, then the window is left alone.
+    Reset();
+    for (int i = 0; i < 3; ++i) {
+        RunHealthyTicks();
+        StopInvoluntarily();
+        assert(s._hwndChecked == NULL);
+    }
+    RunHealthyTicks();
+    StopInvoluntarily();
+    assert(s._hwndChecked == GAME);
+    s._CheckForegroundTimer_Tick({}, {});
+    assert(s.starts == 0);
+
+    // The tally belongs to one window: another source starts with a full budget.
+    Reset();
+    for (int i = 0; i < 4; ++i) StopInvoluntarily();
+    s._hwndCurSrc = OVERLAY;
+    g_foreground = OVERLAY;
+    s._hwndChecked = OVERLAY;
+    s.runtime._State(ScalingState::Idle, StopCause::Involuntary);
+    s._ScalingRuntime_StateChanged(ScalingState::Idle);
+    assert(s._hwndChecked == NULL);
+
+    // A run that lasts past the reset window counts as healthy: the tally clears.
+    Reset();
+    const auto t0 = steady_clock::now();
+    for (int i = 0; i < 4; ++i) assert(s._ShouldRearmAutoScale(GAME, t0 + seconds(i)) == (i < 3));
+    assert(s._ShouldRearmAutoScale(GAME, t0 + seconds(3) + seconds(11)));
+    assert(s._ShouldRearmAutoScale(GAME, t0 + seconds(3) + seconds(12)));
+
+    // Starting scaling by hand gives the window a fresh budget. _StartScaleImpl
+    // does this with `if (!force) _involuntaryStops = 0;`.
+    Reset();
+    for (int i = 0; i < 4; ++i) StopInvoluntarily();
+    s._involuntaryStops = 0;
+    RunHealthyTicks();
+    StopInvoluntarily();
+    assert(s._hwndChecked == NULL);
+
+    // Suspended auto-scale still wins: the task-switch option is untouched.
+    Reset();
+    RunHealthyTicks();
+    s._isAutoScaleSuspended = true;
+    StopInvoluntarily();
+    s._CheckForegroundTimer_Tick({}, {});
+    assert(s.starts == 0);
+
+    // A stop while another window is in front touched nothing before and still
+    // touches nothing, and it does not spend a restart from the budget.
+    Reset();
+    RunHealthyTicks();
+    g_foreground = OVERLAY;
+    StopInvoluntarily();
+    assert(s._hwndChecked == GAME && s._involuntaryStops == 0);
+
+    // No source window: unchanged, the mark is cleared as it was before.
+    Reset();
+    s._hwndCurSrc = NULL;
+    g_foreground = NULL;
+    s._hwndChecked = GAME;
+    s.runtime._State(ScalingState::Idle, StopCause::Involuntary);
+    s._ScalingRuntime_StateChanged(ScalingState::Idle);
+    assert(s._hwndChecked == NULL);
+
+    std::cout << "PASS auto-scale re-arm: deliberate stop still blocks the check, involuntary stop "
+                 "releases the source window, bounded to three restarts per window, tally resets by "
+                 "window, by a healthy run and by a start the player makes\n";
+    return 0;
+}
+'''
+
+harness = (harness
+           .replace('__PUBLISH_STATE__', publish_state)
+           .replace('__REARM__', rearm)
+           .replace('__STATE_CHANGED__', state_changed)
+           .replace('__FOREGROUND_TICK__', foreground_tick))
+output = Path(sys.argv[1]) / 'auto_scale_rearm.cpp'
+output.write_text(harness, encoding='utf-8')
+print(output)
diff --git a/scripts/tests/test_src_shape_settle.py b/scripts/tests/test_src_shape_settle.py
new file mode 100644
index 0000000..7a04e79
--- /dev/null
+++ b/scripts/tests/test_src_shape_settle.py
@@ -0,0 +1,154 @@
+"""Exercise the extracted source-window settle gate without windows or a GPU.
+
+The automatic restart after the source window is hidden must not measure the
+window while its frame is still changing, and must not wait for it forever.
+"""
+from pathlib import Path
+import sys
+
+root = Path(__file__).resolve().parents[2]
+
+
+def method(text, signature):
+    start = text.index(signature)
+    end = text.index('{', start) + 1
+    depth = 1
+    while depth:
+        depth += (text[end] == '{') - (text[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+def read(path):
+    return (root / path).read_text(encoding='utf-8-sig')
+
+
+runtime = read('src/Magpie.Core/ScalingRuntime.cpp')
+tracker = read('src/Magpie.Core/SrcTracker.cpp')
+
+shape = method(runtime, 'struct SrcShape {') + ';'
+get_shape = method(runtime, 'static std::optional<SrcShape> GetSrcShape(')
+settle_state = method(runtime, 'struct SrcSettleState {') + ';'
+settled = method(runtime, 'static bool IsSrcShapeSettled(')
+update_state = method(tracker, 'bool SrcTracker::UpdateState(')
+
+# The restart is gated on the settle check, which only runs once the window is
+# visible again (the reposition poll already returned false).
+loop = runtime.split('} else if (scalingWindow.IsSrcRepositioning()) {', 1)[1]
+loop = loop.split('RestartAfterSrcRepositioned();', 1)[0]
+assert 'IsSrcShapeSettled(hwndSrc, srcSettle)' in loop
+assert loop.index('IsSrcRepositioning(hwndSrc)') < loop.index('IsSrcShapeSettled(')
+# And a running session now notices a frame change that keeps the window rect,
+# which is what makes a measurement that still came out wrong correct itself.
+assert '_clientInset' in update_state and 'sizeChanged = true;' in update_state
+
+harness = r'''
+#include <windows.h>
+#include <cassert>
+#include <chrono>
+#include <iostream>
+#include <optional>
+
+using namespace std::chrono;
+
+inline bool operator==(const RECT& l, const RECT& r) noexcept {
+    return l.left == r.left && l.top == r.top && l.right == r.right && l.bottom == r.bottom;
+}
+
+// Window geometry the test drives directly.
+static RECT g_window{};
+static RECT g_client{};
+static bool g_geometryReadable = true;
+
+static BOOL FakeGetWindowRect(HWND, RECT* out) {
+    if (!g_geometryReadable) return FALSE;
+    *out = g_window;
+    return TRUE;
+}
+#define GetWindowRect FakeGetWindowRect
+
+struct Win32Helper {
+    static bool GetClientScreenRect(HWND, RECT& out) noexcept {
+        if (!g_geometryReadable) return false;
+        out = g_client;
+        return true;
+    }
+};
+
+__SHAPE__
+__GET_SHAPE__
+__SETTLE_STATE__
+__SETTLED__
+
+static HWND const GAME = (HWND)0x400e4a;
+
+static void Borderless() { g_window = { 0, 0, 2560, 1440 }; g_client = g_window; }
+// The window as the player's log caught it mid-change: a border and a title bar.
+static void WithTitleBar() { g_window = { 0, 0, 2560, 1440 }; g_client = { 4, 28, 2556, 1436 }; }
+
+int main() {
+    SrcSettleState state;
+    const auto t0 = steady_clock::now();
+
+    // The first look is never enough, however stable the window looks.
+    Borderless();
+    assert(!IsSrcShapeSettled(GAME, state, t0));
+    // Still inside the settle window.
+    assert(!IsSrcShapeSettled(GAME, state, t0 + 50ms));
+    // Unchanged for long enough: measure it.
+    assert(IsSrcShapeSettled(GAME, state, t0 + 100ms));
+
+    // The frame changing restarts the settle window, so the title bar the game is
+    // about to drop is never what gets measured.
+    state.Reset();
+    WithTitleBar();
+    assert(!IsSrcShapeSettled(GAME, state, t0));
+    assert(!IsSrcShapeSettled(GAME, state, t0 + 90ms));
+    Borderless();
+    assert(!IsSrcShapeSettled(GAME, state, t0 + 100ms));
+    assert(!IsSrcShapeSettled(GAME, state, t0 + 150ms));
+    assert(IsSrcShapeSettled(GAME, state, t0 + 200ms));
+
+    // Moving or resizing restarts it too: the window must have stopped changing
+    // altogether before it is measured.
+    state.Reset();
+    Borderless();
+    assert(!IsSrcShapeSettled(GAME, state, t0));
+    g_window = { 40, 40, 2600, 1480 };
+    g_client = g_window;
+    assert(!IsSrcShapeSettled(GAME, state, t0 + 10ms));
+    assert(!IsSrcShapeSettled(GAME, state, t0 + 100ms));
+    assert(IsSrcShapeSettled(GAME, state, t0 + 110ms));
+
+    // A window whose frame never stops changing is waited for, but not forever.
+    state.Reset();
+    Borderless();
+    assert(!IsSrcShapeSettled(GAME, state, t0));
+    for (int i = 1; i <= 45; ++i) {
+        if (i % 2) WithTitleBar(); else Borderless();
+        const bool settled = IsSrcShapeSettled(GAME, state, t0 + milliseconds(i * 10));
+        assert(settled == (i * 10 >= 400));
+    }
+
+    // Geometry that cannot be read is not something to wait for: let the measure
+    // itself report the real error.
+    state.Reset();
+    g_geometryReadable = false;
+    assert(IsSrcShapeSettled(GAME, state, t0));
+    assert(!state.shape.has_value());
+
+    std::cout << "PASS source shape settle: one look is never enough, a changing frame restarts the "
+                 "wait, the wait is capped at 400 ms and unreadable geometry does not block the "
+                 "restart\n";
+    return 0;
+}
+'''
+
+harness = (harness
+           .replace('__SHAPE__', shape)
+           .replace('__GET_SHAPE__', get_shape)
+           .replace('__SETTLE_STATE__', settle_state)
+           .replace('__SETTLED__', settled))
+output = Path(sys.argv[1]) / 'src_shape_settle.cpp'
+output.write_text(harness, encoding='utf-8')
+print(output)
