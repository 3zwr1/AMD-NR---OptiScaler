+// Scaling can end without anybody asking for it: the capture breaks, a window
+// from another program is in front of the source for a moment, a runtime fault
+// tears the session down. Automatic scaling must arm itself again in that case,
+// or the picture stays off while the player sits in the same game.
+//
+// It is bounded, so a source that fails for a real reason cannot thrash: a few
+// restarts in a row and the window is left alone until scaling is started for
+// it again. A restarted run that lasts longer than the reset window counts as
+// healthy and clears the tally.
+bool ScalingService::_ShouldRearmAutoScale(
+	HWND hwndSrc,
+	std::chrono::steady_clock::time_point now
+) noexcept {
+	static constexpr uint32_t MAX_REARMS = 3;
+	static constexpr std::chrono::seconds REARM_RESET{ 10 };
+
+	if (hwndSrc != _hwndLastInvoluntaryStop || now - _lastInvoluntaryStop > REARM_RESET) {
+		_hwndLastInvoluntaryStop = hwndSrc;
+		_involuntaryStops = 0;
+	}
+	_lastInvoluntaryStop = now;
+
+	++_involuntaryStops;
+	const bool rearm = _involuntaryStops <= MAX_REARMS;
+	Logger::Get().Info(fmt::format(
+		"Scaling ended without a request from the user ({} in a row, at most {}); "
+		"automatic scaling {}", _involuntaryStops, MAX_REARMS,
+		rearm ? "stays armed" :
+		"is left off for this window until it is started again"));
+	Logger::Get().Flush();
+	return rearm;
+}
